<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E60F172A"
    android:padding="14dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Manual Controls"
            android:textColor="@color/emerald"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manual"
            android:textColor="@color/slate300"
            android:layout_marginEnd="8dp"
            android:textSize="12sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchManual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- EV compensation (works in auto mode) -->
    <TextView android:id="@+id/lblEv" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Exposure (EV): 0" android:textColor="@color/white" android:textSize="12sp" />
    <SeekBar android:id="@+id/seekEv" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <!-- ISO -->
    <TextView android:id="@+id/lblIso" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ISO: Auto" android:textColor="@color/white" android:textSize="12sp" />
    <SeekBar android:id="@+id/seekIso" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <!-- Shutter speed -->
    <TextView android:id="@+id/lblShutter" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Shutter: Auto" android:textColor="@color/white" android:textSize="12sp" />
    <SeekBar android:id="@+id/seekShutter" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <!-- Focus distance -->
    <TextView android:id="@+id/lblFocus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Focus: Auto" android:textColor="@color/white" android:textSize="12sp" />
    <SeekBar android:id="@+id/seekFocus" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <!-- Zoom -->
    <TextView android:id="@+id/lblZoom" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Zoom: 1.0x" android:textColor="@color/white" android:textSize="12sp" />
    <SeekBar android:id="@+id/seekZoom" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="White Balance" android:textColor="@color/white" android:textSize="12sp" android:layout_marginEnd="10dp" />

        <Spinner
            android:id="@+id/spinnerWb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
